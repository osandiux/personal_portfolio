[
  {
    "id": "sunday-suppers-about",
    "title": "About Sunday Suppers",
    "folder": "Sunday Suppers",
    "body": "What Sunday Suppers is and how we score each dish.",
    "aboutContent": {
      "intro": "Sunday Suppers is a hangout series with my bestie Anjuli. We take cool and interesting recipes from social media and try to make them, all while catching up during our busy lives. We then rank each dish according to our criteria below.",
      "scoringIntro": "Each category is scored by both of us (Chris and Anjuli). The columns in the table are our individual scores; Sum is the total for that row.",
      "criteria": [
        { "label": "Taste (out of 10)", "description": "How good it was to eat" },
        { "label": "Appearance (out of 5)", "description": "How it looked on the plate" },
        { "label": "Effort (out of 5)", "description": "Low score = high effort, high score = low effort" },
        { "label": "Misc (out of 5)", "description": "How memorable, fun, etc." }
      ],
      "footer": "Maximum total per person: 25 points. Higher total = we liked it more."
    }
  },
